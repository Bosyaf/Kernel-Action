diff --git a/include/linux/cpufreq_health.h b/include/linux/cpufreq_health.h
new file mode 100755
index 0000000000000..e9a70495bf975
--- /dev/null
+++ b/include/linux/cpufreq_health.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (C) 2021 Oplus. All rights reserved.
+ */
+
+
+#ifndef _CPUFREQ_HEALTH_H
+#define _CPUFREQ_HEALTH_H
+#include <linux/kernel_stat.h>
+#include <linux/cpufreq.h>
+#include <linux/sched.h>
+#include <linux/cpu.h>
+#include <linux/types.h>
+#include <linux/slab.h>
+
+struct oplus_cpufreq_frequency_table {
+	unsigned int frequency;
+	u64 floor_time;
+	u64 ceiling_time;
+	s64 floor_count;
+	s64 ceiling_count;
+	unsigned int voltage;
+};
+
+#if IS_ENABLED(CONFIG_SCHED_WALT)
+struct oplus_cpu_edtask_table {
+	int edtask_state;
+};
+#endif
+
+struct oplus_cpufreq_health {
+	struct oplus_cpufreq_frequency_table *table;
+	unsigned int prev_floor_freq;
+	unsigned int curr_floor_freq;
+	unsigned int prev_ceiling_freq;
+	unsigned int curr_ceiling_freq;
+	u64 last_update_time;
+	u64 bootup_time;
+	unsigned int len;
+	unsigned int cpu_count;
+	spinlock_t lock;
+	struct kobject kobj;
+	int is_init;
+#if IS_ENABLED(CONFIG_SCHED_WALT)
+	struct oplus_cpu_edtask_table *edtask_table;
+	u64 newtask_boost_time;
+	u64 edtask_boost_time;
+	u64 last_update_util_time;
+	u64 last_update_edtask_time;
+	int pre_newtask_state;
+	int pre_edtask_state;
+	s64 newtask_count;
+	s64 edtask_count;
+#endif
+};
+
+/* add for midas data collection */
+struct cpufreq_health_info {
+	u64 ceiling_time;
+	u64 ceiling_count;
+	u64 floor_time;
+	u64 floor_count;
+};
+
+extern void cpufreq_health_get_state(struct cpufreq_policy *policy);
+extern int freq_to_voltage(int cluster_id, unsigned int target_freq);
+
+#if IS_ENABLED(CONFIG_SCHED_WALT)
+extern void cpufreq_health_get_newtask_state(struct cpufreq_policy *policy, int newtask_flag);
+extern void cpufreq_health_get_edtask_state(int cpu, int edtask_flag);
+#endif
+
+#if IS_ENABLED(CONFIG_OPLUS_FEATURE_OCH)
+void get_cpufreq_health_info(int *cnt, struct cpufreq_health_info *val);
+extern int cpufreq_health_register(struct cpufreq_policy *policy);
+#else
+static inline void get_cpufreq_health_info(int *cnt, struct cpufreq_health_info *val) {}
+extern int cpufreq_health_register(struct cpufreq_policy *policy) { return 0; }
+#endif
+
+#endif /* _CPUFREQ_HEALTH_H */
diff --git a/kernel/sched/uad/Kconfig b/kernel/sched/uad/Kconfig
new file mode 100644
index 0000000000000..b2777636206bf
--- /dev/null
+++ b/kernel/sched/uad/Kconfig
@@ -0,0 +1,67 @@
+config OPLUS_CPU_FREQ_GOV_UAG
+	tristate "uag cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  This governor makes decisions based on the utilization.  It sets
+          the CPU frequency to be proportional to the utilization/capacity
+          ratio coming from the scheduler or frameboost.  If the utilization
+          is frequency-invariant, the new frequency is also proportional to
+          the maximum available frequency.  If that is not the case, it is
+          proportional to the current frequency of the CPU.
+
+	  If in doubt, say N.
+
+config UAG_NONLINEAR_FREQ_CTL
+	bool "Non-linear frequency control"
+	depends on OPLUS_CPU_FREQ_GOV_UAG
+	default n
+	help
+	  Choose this option to enable non-linear frequency control.
+	  This will change per-opp capacity from linear scaled by
+	  freuqency to evaluated by benchmark. This makes capacity
+	  more accurate and will let scheduler/schedutil use more
+	  suitable frequency.
+
+config OPLUS_UAG_USE_TL
+	bool "use target loads in uag cpufreq policy governor"
+	depends on OPLUS_CPU_FREQ_GOV_UAG
+	default n
+	help
+	  Add target_loads sysfs attr in uag cpufreq policy governor.
+
+config UA_KERNEL_CPU_IOCTL
+	tristate "cpu ioctl interface"
+	default n
+	help
+	  Provide ioctl interface for cpu features.
+
+config OPLUS_UAG_AMU_AWARE
+	bool "consider amu info for cpufreq decision"
+	depends on OPLUS_CPU_FREQ_GOV_UAG
+	default n
+	help
+	  Consider AMU info such as cycles/stall ... to adjust cpufreq.
+
+config OPLUS_MULTI_LV_TL
+	bool "Add multi-level target loads to scale cpu frequency"
+	depends on OPLUS_CPU_FREQ_GOV_UAG
+	default n
+	help
+	  Add multi-level target loads to scale cpu frequency.
+
+config OPLUS_FEATURE_TOUCH_BOOST
+	bool "touch_boost"
+	depends on OPLUS_CPU_FREQ_GOV_UAG
+	default n
+	help
+	  oplus touch boost
+
+config OPLUS_UAG_SOFT_LIMIT
+	bool "soft frequency limit in uag cpufreq policy governor"
+	depends on OPLUS_CPU_FREQ_GOV_UAG
+	default n
+	help
+	  Add soft frequency limit in uag cpufreq policy governor.
+	  Frequency can breakthrough this limit in UA scene.
