--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -577,6 +577,40 @@ struct cfs_rq {
 
 	struct rb_root_cached	tasks_timeline;
 
+#ifdef CONFIG_SCHED_BORE
+	/* Cooldown for bore_warp_preempt() in fair.c: at most one hard
+	 * "warp" preemption grant per sched_bore_warp_us on this cfs_rq,
+	 * regardless of how many fresh-looking tasks wake up in that
+	 * window. See the comment on bore_warp_preempt() for why this is a
+	 * cooldown and not a per-task allowance. */
+	u64			bore_warp_deadline;
+	/* Set by bore_warp_preempt() the instant it grants a warp; consumed
+	 * (test-and-cleared) by PCCG's pccg_bore_warp_check() in
+	 * cpufreq_pccg.c as a cross-subsystem signal -- see the comment
+	 * there for why a warp grant gets treated differently from PCCG's
+	 * own, weaker burst_penalty-only check.
+	 *
+	 * unsigned long + test_and_clear_bit(), not a plain bool: in a
+	 * shared cpufreq policy (the common case for an Android cluster),
+	 * PCCG reads/clears this for CPUs other than the one currently
+	 * holding this rq's own lock (pccg_next_freq_shared() loops over
+	 * every CPU in the policy, most of them remote from whichever CPU
+	 * is actually running that loop) -- a plain bool read-then-write
+	 * there races against bore_warp_preempt() setting it concurrently
+	 * under the *other* CPU's own rq lock. test_and_clear_bit() makes
+	 * the read-and-clear atomic regardless of which CPU's lock (if
+	 * any) the caller happens to be holding. */
+	unsigned long		bore_warp_fired;
+/* Companion define for cpufreq_pccg.c (or any other consumer) to detect
+ * that this field actually exists, independent of CONFIG_SCHED_BORE
+ * alone: BORE's base patch does not provide bore_warp_fired by itself --
+ * only this addon (bore-warp) does. A consumer built against a tree that
+ * has CONFIG_SCHED_BORE but not this patch must not reference the field
+ * at all, or it fails to compile; checking this define instead of
+ * CONFIG_SCHED_BORE lets it degrade to a clean no-op in that case. */
+#define SAGA_HAVE_BORE_WARP_HINT 1
+#endif
+
