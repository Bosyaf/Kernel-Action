+
+/************************** helper functions ****************************/
+
+static inline struct uag_policy *uag_policy_get(struct cpufreq_policy *policy)
+{
+	return per_cpu(uag_cpu_data, policy->cpu);
+}
+
+static inline void uag_update_rate_limits(struct uag_policy *sg_policy,
+					  struct uag_tunables *tunables)
+{
+	sg_policy->up_rate_delay_ns = tunables->up_rate_limit_us * NSEC_PER_USEC;
+	sg_policy->down_rate_delay_ns = tunables->down_rate_limit_us * NSEC_PER_USEC;
+	sg_policy->min_rate_limit_ns = min(sg_policy->up_rate_delay_ns,
+					   sg_policy->down_rate_delay_ns);
+}
+
+static inline bool uag_update_rate_limit(struct uag_policy *sg_policy, u64 time,
+					 unsigned int next_freq)
+{
+	u64 delta_ns = time - sg_policy->last_freq_update_time;
+	
+	if (sg_policy->next_freq > next_freq) {
+		/* Going down */
+		if (delta_ns < sg_policy->down_rate_delay_ns)
+			return true;
+	} else if (sg_policy->next_freq < next_freq) {
+		/* Going up */
+		if (delta_ns < sg_policy->up_rate_delay_ns)
+			return true;
+	}
+	
+	return false;
+}
+
+static inline unsigned int uag_freq_to_target(struct cpufreq_policy *policy,
+					       unsigned int target_freq)
+{
+	if (policy->fast_switch_enabled)
+		return target_freq;
+	
+	return target_freq;
+}
+
+static void uag_adjust_freq(struct uag_policy *sg_policy, unsigned long util,
+			    unsigned long max, u64 time)
+{
+	struct uag_tunables *tunables = sg_policy->tunables;
+	struct cpufreq_policy *policy = sg_policy->policy;
+	unsigned int next_freq;
+	unsigned int hispeed_freq;
+	
+	/* Calculate next frequency based on util */
+	next_freq = util * policy->cpuinfo.max_freq / max;
+	
+	/* Apply hispeed logic */
+	hispeed_freq = tunables->hispeed_freq ? : policy->cpuinfo.max_freq;
+	
+	if (util > tunables->hispeed_load * max / 100) {
+		if (next_freq < hispeed_freq)
+			next_freq = hispeed_freq;
+	}
+	
+	/* Gaming mode aggressive scaling */
+	if (tunables->gaming_mode && util > max / 2) {
+		next_freq = max(next_freq, policy->cpuinfo.max_freq * 8 / 10);
+	}
+	
+	/* Touch boost check */
+	if (atomic_read(&sg_policy->touch_boost_active)) {
+		if (time < sg_policy->touch_boost_end_time) {
+			if (tunables->touch_boost_freq)
+				next_freq = max(next_freq, tunables->touch_boost_freq);
+			else
+				next_freq = policy->cpuinfo.max_freq;
+		} else {
+			atomic_set(&sg_policy->touch_boost_active, 0);
+		}
+	}
+	
+	/* Apply frequency limits */
+	next_freq = max(next_freq, policy->min);
+	next_freq = min(next_freq, policy->max);
+	
+	/* Rate limiting */
+	if (uag_update_rate_limit(sg_policy, time, next_freq))
+		return;
+	
+	sg_policy->next_freq = next_freq;
+}
+
+static void uag_update_shared(struct update_util_data *hook, u64 time,
+			      unsigned int flags)
+{
+	struct uag_policy *sg_policy = container_of(hook, struct uag_policy, update_util);
+	struct uag_tunables *tunables = sg_policy->tunables;
+	struct cpufreq_policy *policy = sg_policy->policy;
+	unsigned long util, max;
+	
+	raw_spin_lock(&sg_policy->update_lock);
+	
+	if (flags & SCHED_CPUFREQ_RT_DL) {
+		/* RT/DL tasks - go max */
+		sg_policy->next_freq = policy->cpuinfo.max_freq;
+		goto out;
+	}
+	
+	/* Get util from scheduler */
+	util = cpu_util_freq(sg_policy->policy->cpu);
+	max = cpu_bw_dl(sg_policy->policy->cpu);
+	
+	if (unlikely(!max)) {
+		/* No BW constraint - use arch_scale_cpu_capacity */
+		max = arch_scale_cpu_capacity(sg_policy->policy->cpu);
+	}
+	
+	uag_adjust_freq(sg_policy, util, max, time);
+	
+out:
+	raw_spin_unlock(&sg_policy->update_lock);
+}
+
+static void uag_deferred_update(struct uag_policy *sg_policy, u64 time,
+				unsigned int next_freq)
+{
+	if (sg_policy->next_freq == next_freq)
+		return;
+	
+	sg_policy->next_freq = next_freq;
+	sg_policy->last_freq_update_time = time;
+	
+	/* Queue work for frequency change */
+	irq_work_queue(&sg_policy->irq_work);
+}
+
+static void uag_irq_work(struct irq_work *irq_work)
+{
+	struct uag_policy *sg_policy;
+	
+	sg_policy = container_of(irq_work, struct uag_policy, irq_work);
+	kthread_queue_work(&sg_policy->worker, &sg_policy->work);
+}
+
+static void uag_work(struct kthread_work *work)
+{
+	struct uag_policy *sg_policy = container_of(work, struct uag_policy, work);
+	unsigned int freq;
+	unsigned long flags;
+	
+	raw_spin_lock_irqsave(&sg_policy->update_lock, flags);
+	freq = sg_policy->next_freq;
+	raw_spin_unlock_irqrestore(&sg_policy->update_lock, flags);
+	
+	if (freq == sg_policy->cached_raw_freq && !sg_policy->policy->fast_switch_enabled)
+		return;
+	
+	sg_policy->cached_raw_freq = freq;
+	
+	__cpufreq_driver_target(sg_policy->policy, freq, CPUFREQ_RELATION_L);
+}
+
+/************************** notifier ****************************/
+
+static int uag_notifier(struct notifier_block *nb, unsigned long val, void *data)
+{
+	struct uag_policy *sg_policy = container_of(nb, struct uag_policy, nb);
+	struct cpufreq_freqs *freq = data;
+	
+	if (val == CPUFREQ_POSTCHANGE && freq->policy == sg_policy->policy) {
+		sg_policy->last_freq_update_time = ktime_get_ns();
+	}
+	
+	return 0;
+}
+
+/************************** init/exit ****************************/
+
+static int uag_init(struct cpufreq_policy *policy)
+{
+	struct uag_policy *sg_policy;
+	struct uag_tunables *tunables;
+	int ret = 0;
+	int i;
+	
+	/* Allocate policy structure */
+	sg_policy = kzalloc(sizeof(*sg_policy), GFP_KERNEL);
+	if (!sg_policy)
+		return -ENOMEM;
+	
+	sg_policy->policy = policy;
+	raw_spin_lock_init(&sg_policy->update_lock);
+	
+	/* Init work items */
+	kthread_init_work(&sg_policy->work, uag_work);
+	kthread_init_worker(&sg_policy->worker);
+	sg_policy->worker.task = kthread_create(kthread_worker_fn, &sg_policy->worker,
+						"uag_%d", policy->cpu);
+	if (IS_ERR(sg_policy->worker.task)) {
+		ret = PTR_ERR(sg_policy->worker.task);
+		goto free_sg_policy;
+	}
+	
+	wake_up_process(sg_policy->worker.task);
+	
+	irq_work_init(&sg_policy->irq_work, uag_irq_work);
+	atomic_set(&sg_policy->touch_boost_active, 0);
+	
+	/* Setup tunables */
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		sg_policy->tunables = global_tunables;
+		tunables = global_tunables;
+	} else {
+		tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+		if (!tunables) {
+			ret = -ENOMEM;
+			goto stop_kthread;
+		}
+		
+		tunables->down_rate_limit_us = UAG_DOWN_RATE_LIMIT_DEFAULT;
+		tunables->up_rate_limit_us = UAG_UP_RATE_LIMIT_DEFAULT;
+		tunables->hispeed_freq = UAG_HISPEED_FREQ_DEFAULT;
+		tunables->hispeed_load = UAG_HISPEED_LOAD_DEFAULT;
+		tunables->touch_boost_duration = UAG_TOUCH_BOOST_DURATION_DEFAULT;
+		tunables->touch_boost_freq = UAG_TOUCH_BOOST_FREQ_DEFAULT;
+		tunables->gaming_mode = 0;
+		tunables->frame_drop_threshold = 3;
+		tunables->sync_on_async = 0;
+		
+		gov_attr_set_init(&tunables->attr_set, &sg_policy->tunables_hook);
+		
+		if (!have_governor_per_policy())
+			global_tunables = tunables;
+		
+		sg_policy->tunables = tunables;
+	}
+	
+	uag_update_rate_limits(sg_policy, tunables);
+	
+	sg_policy->nb.notifier_call = uag_notifier;
+	cpufreq_register_notifier(&sg_policy->nb, CPUFREQ_TRANSITION_NOTIFIER);
+	
+	/* Per-cpu init */
+	for_each_cpu(i, policy->cpus) {
+		per_cpu(uag_cpu_data, i) = sg_policy;
+	}
+	
+	policy->governor_data = sg_policy;
+	
+	return 0;
+	
+stop_kthread:
+	kthread_stop(sg_policy->worker.task);
+free_sg_policy:
+	kfree(sg_policy);
+	return ret;
+}
+
+static void uag_exit(struct cpufreq_policy *policy)
+{
+	struct uag_policy *sg_policy = policy->governor_data;
+	unsigned int count;
+	
+	cpufreq_unregister_notifier(&sg_policy->nb, CPUFREQ_TRANSITION_NOTIFIER);
+	
+	count = gov_attr_set_put(&sg_policy->tunables->attr_set, &sg_policy->tunables_hook);
+	if (!count) {
+		/* Last policy using these tunables */
+		if (!have_governor_per_policy())
+			global_tunables = NULL;
+		kfree(sg_policy->tunables);
+	}
+	
+	kthread_flush_worker(&sg_policy->worker);
+	kthread_stop(sg_policy->worker.task);
+	
+	kfree(sg_policy);
+	policy->governor_data = NULL;
+}
+
+static int uag_start(struct cpufreq_policy *policy)
+{
+	struct uag_policy *sg_policy = policy->governor_data;
+	unsigned int espeed_freq;
+	
+	sg_policy->last_freq_update_time = ktime_get_ns();
+	sg_policy->next_freq = policy->cur;
+	sg_policy->cached_raw_freq = policy->cur;
+	
+	/* Register update util hook */
+	sg_policy->update_util.func = uag_update_shared;
+	cpufreq_add_update_util_hook(policy->cpu, &sg_policy->update_util,
+				     uag_update_shared);
+	
+	return 0;
+}
+
+static void uag_stop(struct cpufreq_policy *policy)
+{
+	struct uag_policy *sg_policy = policy->governor_data;
+	
+	cpufreq_remove_update_util_hook(policy->cpu);
+	synchronize_sched();
+	
+	irq_work_sync(&sg_policy->irq_work);
+	kthread_flush_work(&sg_policy->work);
+}
+
+static void uag_limits(struct cpufreq_policy *policy)
+{
+	struct uag_policy *sg_policy = policy->governor_data;
+	unsigned long flags;
+	unsigned int freq;
+	
+	raw_spin_lock_irqsave(&sg_policy->update_lock, flags);
+	
+	freq = sg_policy->next_freq;
+	
+	/* Clamp to new limits */
+	if (freq > policy->max)
+		freq = policy->max;
+	if (freq < policy->min)
+		freq = policy->min;
+	
+	if (sg_policy->next_freq != freq) {
+		sg_policy->next_freq = freq;
+		irq_work_queue(&sg_policy->irq_work);
+	}
+	
+	raw_spin_unlock_irqrestore(&sg_policy->update_lock, flags);
+}
+
+/************************** external interface ****************************/
+
+void uag_set_touch_boost(struct cpufreq_policy *policy, unsigned int boost_freq)
+{
+	struct uag_policy *sg_policy = policy->governor_data;
+	struct uag_tunables *tunables;
+	u64 now;
+	
+	if (!sg_policy)
+		return;
+	
+	tunables = sg_policy->tunables;
+	if (!tunables)
+		return;
+	
+	now = ktime_get_ns();
+	atomic_set(&sg_policy->touch_boost_active, 1);
+	sg_policy->touch_boost_end_time = now + (tunables->touch_boost_duration * NSEC_PER_MSEC);
+	
+	/* Trigger immediate update */
+	irq_work_queue(&sg_policy->irq_work);
+}
+EXPORT_SYMBOL_GPL(uag_set_touch_boost);
+
+void uag_set_gaming_mode(struct cpufreq_policy *policy, bool enabled)
+{
+	struct uag_policy *sg_policy = policy->governor_data;
+	
+	if (!sg_policy || !sg_policy->tunables)
+		return;
+	
+	sg_policy->tunables->gaming_mode = enabled ? 1 : 0;
+}
+EXPORT_SYMBOL_GPL(uag_set_gaming_mode);
+
+static struct cpufreq_governor uag_governor = {
+	.name = "uag",
+	.owner = THIS_MODULE,
+	.init = uag_init,
+	.exit = uag_exit,
+	.start = uag_start,
+	.stop = uag_stop,
+	.limits = uag_limits,
+};
+
+static int __init uag_gov_init(void)
+{
+	return cpufreq_register_governor(&uag_governor);
+}
+
+static void __exit uag_gov_exit(void)
+{
+	cpufreq_unregister_governor(&uag_governor);
+}
+
+MODULE_AUTHOR("Ported to 6.1 for SM8650");
+MODULE_DESCRIPTION("Userspace Android Gaming CPUFreq Governor");
+MODULE_LICENSE("GPL v2");
+
+fs_initcall(uag_gov_init);
+module_exit(uag_gov_exit);
